# --- Telegram ---------------------------------------------------------------
TG_BOT_TOKEN=
# chat where the bot posts events and answers commands
TG_CHAT_ID=
# optional: channel where new-player announcements are forwarded
TG_CHANNEL_ID=
# numeric Telegram user id of the admin (/wl_add, /wl_remove); empty = admin commands disabled.
# Unknown? Send /wl_add from your account: the bot logs "user id ... is not admin".
TG_ADMIN_ID=
# optional: proxy for Telegram API (the tg-tunnel service from the Minecraft compose)
TG_PROXY=socks5h://tg-tunnel:1080

# --- Minecraft ---------------------------------------------------------------
RCON_HOST=mc
RCON_PORT=25575
RCON_PASSWORD=

SERVER_NAME=The Brave New World
# comma-separated nicks the bot never mentions
ALLAY_HIDDEN=admin
TZ=Europe/Moscow

# --- docker compose (host side) ----------------------------------------------
# Minecraft project dir: data/ and backups/ are mounted read-only from here
MC_DIR=/opt/minecraft
# docker network of the Minecraft compose project (`docker network ls`)
MC_NETWORK=minecraft_default
# dir with players.json (nick -> {"telegram": "..."}), maintained by the bot
ALLAY_STATE_DIR=./state
