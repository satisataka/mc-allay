# --- Telegram ---------------------------------------------------------------
TG_BOT_TOKEN=
# chat where the bot posts events and answers commands
TG_CHAT_ID=
# optional: channel linked to the chat. New-player announcements are posted there,
# and Telegram itself copies them into the chat (so the bot doesn't post them twice)
TG_CHANNEL_ID=
# numeric Telegram user id of the admin (/wl_add, /wl_remove); empty = admin commands disabled.
# Unknown? Send /wl_add from your account: the bot logs "user id ... is not admin".
TG_ADMIN_ID=
# optional: proxy for Telegram API (the tg-tunnel service from the Minecraft compose)
TG_PROXY=socks5h://tg-tunnel:1080

# --- Minecraft ---------------------------------------------------------------
RCON_HOST=mc
RCON_PORT=25575
RCON_PASSWORD=

SERVER_NAME=The Brave New World
# comma-separated nicks the bot never mentions
ALLAY_HIDDEN=admin
TZ=Europe/Moscow

# --- admin alerts (private chat with TG_ADMIN_ID) -----------------------------
# server doesn't answer RCON for N min without a planned "Stopping server"
ALERT_DOWN_MINUTES=2
# after a planned stop the server isn't back for N min
ALERT_RESTART_MINUTES=5
# MSPT (p95) above the threshold for N min
ALERT_MSPT=50
ALERT_LAG_MINUTES=5
# newest backup is older than N hours while someone has played for 30+ min
# (mc-backup pauses without players, so an old backup alone is fine)
ALERT_BACKUP_HOURS=14
ALERT_DISK_GB=5
# reminder interval for ongoing backup / disk problems
ALERT_REPEAT_HOURS=6

# --- docker compose (host side) ----------------------------------------------
# Minecraft project dir: data/ and backups/ are mounted read-only from here
MC_DIR=/opt/minecraft
# docker network of the Minecraft compose project (`docker network ls`)
MC_NETWORK=minecraft_default
# dir with players.json (nick -> {"telegram": "..."}), maintained by the bot
ALLAY_STATE_DIR=./state
